{
  "builds": [
    { "src": "index.php", "use": "vercel-php@0.9.0" },
    { "src": "assets/**", "use": "@vercel/static" }
  ],
  "redirects": [
    { "source": "/config/(.*)", "destination": "/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/(.*\\.php)", "destination": "/index.php" },
    { "source": "/", "destination": "/index.php" }
  ]
}
