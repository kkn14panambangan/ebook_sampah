{
  "functions": {
    "api/*.php": { "runtime": "vercel-php@0.9.0" }
  },
  "redirects": [
    { "source": "/config/(.*)", "destination": "/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/(.*\\.php)", "destination": "/api/index.php" },
    { "source": "/", "destination": "/api/index.php" }
  ]
}
